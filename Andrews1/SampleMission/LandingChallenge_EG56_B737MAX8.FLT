[Main]
Title=$$:737 MAX 8 into Saint Andrews
Description=$$:ILS 13 EG56 - short coastal runway
AppVersion=10.0.282174
FlightVersion=1
MissionType=LandingChallenge
; Famous = easy, Epic = hard airport, StrongWind = weather is the challenge
; EG56 is ~6414 ft / 1955 m. Tight for a MAX 8, so Epic.
MissionSubType=Epic

[Options]
Sound=True
Pause=True
Moonlight=True
TextDisplayPage=0
SlewDisplayPage=1
AxisIndicator=Off
Titles=False

[Sim.0]
; Aircraft title from aircraft.cfg. Change this to match the MAX 8 you have installed.
; Default 2024: 737 Max 8 Passengers
; Other titles you may need: Boeing 737 Max 8   or   737 Max 8
Sim=737 Max 8 Passengers
SimFile=final.FLT

[ResourcePath]
; Do not change - Asobo landing-challenge logic
Path=Missions\Asobo\LandingChallenges\default\

[ObjectFile]
; Airliner scoring (touchdown zone, sink rate, centreline)
File=Missions\Asobo\LandingChallenges\default\LandingChallenge_Airliner

[Atc_Menu]
Visible=False

[Weather]
UseWeatherFile=False

[Assistance]
Preset=ASSISTANCE_PRESET_LANDING_CHALLENGE

[Arrival]
ICAO=EG56
RunwayNumber=13
RunwayDesignator=NONE

[Briefing]
BriefingText=$$:Boeing 737 MAX 8 into Saint Andrews (EG56). You are 8 NM on the ILS 13 (ISAN, 111.10, inbound 130). The runway is only 1955 m / 6414 ft. Capture the localiser and glideslope, stay on speed, and put it in the touchdown zone. Missed approach: climb heading 130 to 3000 ft.
BriefingImage0=./images/Briefing.jpg
StartUpLocationInfo0=FLIGHT_INFO_RUNWAY_ARRIVAL_ELEVATION
StartUpLocationInfo1=FLIGHT_INFO_RUNWAY_ARRIVAL_SLOPE
StartUpLocationInfo2=FLIGHT_INFO_LOCATION_TIME
StartUpLocationInfo3=FLIGHT_INFO_LOCATION_WIND
StartUpAircraftInfo0=FLIGHT_INFO_AIRCRAFT_IAS
StartUpAircraftInfo1=FLIGHT_INFO_AIRCRAFT_HEADING
StartUpAircraftInfo2=FLIGHT_INFO_AIRCRAFT_STALL_SPEED_FLAPS_UP

[Loading]
ImageName=./images/Loading.jpg
Tips0=TT:LOADING.SPECIFIC_TIPS.LANDING_PRECISION
Tips1=TT:LOADING.SPECIFIC_TIPS.CENTERLINE
Tips2=TT:LOADING.SPECIFIC_TIPS.LANDING_SMOOTHNESS
Tips3=Tune NAV1 111.10 / course 130. Ident ISAN.
Tips4=Short runway. Idle at 50 ft, firm touchdown, max reverse, autobrake.

